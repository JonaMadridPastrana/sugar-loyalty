# Copia este archivo como .env y completa los valores en tu computadora.
# No compartas .env ni escribas credenciales reales en este archivo de ejemplo.
POSTGRES_DB=sugar_loyalty_db
POSTGRES_USER=sugar_loyalty
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_UNICA

GOOGLE_WALLET_ISSUER_ID=CAMBIAR_POR_EL_ISSUER_ID
GOOGLE_WALLET_CREDENTIALS_PATH=./secrets/google-wallet-credentials.json

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CAMBIAR_POR_EL_CORREO_DE_ENVIO
SPRING_MAIL_PASSWORD=CAMBIAR_POR_LA_CLAVE_DE_APLICACION
